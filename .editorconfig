root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Trailing whitespace is significant in Fountain (a line of two spaces keeps
# dialogue together across a blank line).
[*.fountain]
trim_trailing_whitespace = false
