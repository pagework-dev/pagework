{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // Relative imports name the .ts file so Node can run sources directly
    // (type stripping) for the CLI and debug commands, with no build step.
    "allowImportingTsExtensions": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    // Packages must run unchanged in the browser and in Node (ADR 0003), so no
    // ambient Node or DOM types unless a package opts in.
    "types": [],

    "skipLibCheck": true
  }
}
